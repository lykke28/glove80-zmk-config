/* Custom Device-tree */

/* ==== PER-KEY-RGB (darknao/valdur per-layer underglow) ====
 * Gaming layer indicator. All other layers are dark.
 * Colors:
 *   WASD            -> GREEN
 *   action keys     -> RED   (Tab, Q, E, R, F, LShift, LCtrl, Space)
 *   numbers 1-5     -> light blue (0x00BFFF)
 *   numbers 6-0     -> dark blue  (0x0000AA)
 * Positions map 1:1 onto the keymap grid for each layer.
 */
/ {
    underglow-layer {
        compatible = "zmk,underglow-layer";

        gaming {
            bindings = <
    &ug ___      &ug ___      &ug ___      &ug ___      &ug ___                                                                                                  &ug ___ &ug ___ &ug ___ &ug ___ &ug ___
    &ug ___      &ug 0x0000AA &ug 0x0000AA &ug 0x0000AA &ug 0x0000AA &ug 0x0000AA                                                              &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___
    &ug ___      &ug 0x00BFFF &ug 0x00BFFF &ug 0x00BFFF &ug 0x00BFFF &ug 0x00BFFF                                                              &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___
    &ug ___      &ug RED      &ug RED      &ug GREEN    &ug RED       &ug RED                                                                   &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___
    &ug RED      &ug ___      &ug GREEN    &ug GREEN    &ug GREEN     &ug RED      &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___              &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___
    &ug RED      &ug ___      &ug ___      &ug ___      &ug ___                    &ug RED  &ug ___ &ug ___ &ug ___ &ug ___ &ug ___             &ug ___ &ug ___ &ug ___ &ug ___ &ug ___
                >;
            layer-id = <LAYER_Gaming>;
        };
    };
};
/* ==== PER-KEY-RGB <end> ==== */


